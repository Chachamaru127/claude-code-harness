<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Progress Tracker: {{project}}</title>
<style>
  /* Claude Harness Brand palette */
  :root {
    --harness-bg:     #FAFAFA;
    --harness-fg:     #0F0F0F;
    --harness-muted:  #6B6B6B;
    --harness-line:   #E5E5E5;
    --harness-orange: #F58A4A;
    --harness-green:  #4A9B5C;
    --harness-amber:  #C99A2E;
    --alert-info-bg:  #EAF2FB;
    --alert-info-fg:  #2B5F9E;
    --alert-warn-bg:  #FBF4E3;
    --alert-warn-fg:  #8A6510;
    --alert-crit-bg:  #FBE9E7;
    --alert-crit-fg:  #B23B22;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    padding: 0;
    background: var(--harness-bg);
    color: var(--harness-fg);
    font-family: "Inter", "Noto Sans JP", system-ui, sans-serif;
    font-weight: 400;
    line-height: 1.7;
    word-break: keep-all;
    overflow-wrap: normal;
  }
  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 48px 32px;
  }
  h1 {
    font-size: 1.6em;
    font-weight: 500;
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }
  .meta {
    color: var(--harness-muted);
    font-size: 0.9em;
    margin-bottom: 32px;
  }
  .pct-block {
    background: #fff;
    border: 1px solid var(--harness-line);
    border-radius: 6px;
    padding: 24px 28px;
    margin-bottom: 32px;
  }
  .pct-num {
    font-size: 3.2em;
    font-weight: 300;
    color: var(--harness-orange);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .pct-label {
    color: var(--harness-muted);
    font-size: 0.95em;
    margin-top: 4px;
  }
  .progress-bar {
    height: 6px;
    background: var(--harness-line);
    border-radius: 3px;
    margin-top: 16px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: var(--harness-orange);
    width: {{progress_pct}}%;
    transition: width 0.3s;
  }
  .counts {
    display: flex;
    gap: 32px;
    margin-top: 16px;
    font-size: 0.95em;
  }
  .counts span {
    color: var(--harness-muted);
  }
  .counts strong {
    font-weight: 500;
    color: var(--harness-fg);
    margin-right: 4px;
  }
  .current {
    margin-bottom: 32px;
    padding: 16px 20px;
    background: #fff;
    border-left: 3px solid var(--harness-orange);
    border-radius: 0 4px 4px 0;
  }
  .current-label {
    font-size: 0.85em;
    color: var(--harness-muted);
    margin-bottom: 4px;
  }
  .current-task {
    font-weight: 500;
  }
  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 32px;
  }
  .stat-card {
    background: #fff;
    border: 1px solid var(--harness-line);
    border-radius: 4px;
    padding: 16px 20px;
  }
  .stat-label {
    font-size: 0.8em;
    color: var(--harness-muted);
    margin-bottom: 4px;
  }
  .stat-value {
    font-size: 1.25em;
    font-weight: 500;
  }
  section {
    margin-bottom: 32px;
  }
  h2 {
    font-size: 1.0em;
    font-weight: 500;
    color: var(--harness-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 12px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    padding: 8px 0;
    border-bottom: 1px solid var(--harness-line);
    display: flex;
    gap: 12px;
    align-items: baseline;
  }
  li:last-child { border-bottom: none; }
  .task-num {
    font-family: ui-monospace, "SF Mono", monospace;
    font-size: 0.85em;
    color: var(--harness-muted);
    min-width: 70px;
  }
  .task-title { flex: 1; }
  .task-commit {
    font-family: ui-monospace, "SF Mono", monospace;
    font-size: 0.8em;
    color: var(--harness-green);
  }
  .alert {
    border-left: 3px solid;
    padding: 10px 14px;
    margin-bottom: 8px;
    border-radius: 0 4px 4px 0;
    font-size: 0.9em;
  }
  .alert-info     { background: var(--alert-info-bg); border-color: var(--alert-info-fg); color: var(--alert-info-fg); }
  .alert-warn     { background: var(--alert-warn-bg); border-color: var(--alert-warn-fg); color: var(--alert-warn-fg); }
  .alert-critical { background: var(--alert-crit-bg); border-color: var(--alert-crit-fg); color: var(--alert-crit-fg); }
  .alert-kind {
    font-weight: 500;
    margin-right: 8px;
    text-transform: uppercase;
    font-size: 0.75em;
    letter-spacing: 0.05em;
  }
  .alert-action {
    margin-top: 4px;
    color: var(--harness-muted);
    font-size: 0.85em;
  }
  footer {
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid var(--harness-line);
    color: var(--harness-muted);
    font-size: 0.8em;
  }
  /* 箱の見た目 (背景・border) は行 (.wl-row) 側にだけ付ける。writing-lint-pending 自体は
     枠なしにして、pending 配列が空のとき section の中身が展開されない = 視覚的な
     箱も残らない (DoD b: pending 0 件でセクション非表示) */
  .wl-header {
    margin: 0 0 4px;
  }
  .wl-note {
    font-size: 0.85em;
    color: var(--harness-muted);
    margin-bottom: 12px;
  }
  /* section 全体は render-html.sh の block iteration により writing_lint_pending
     の件数だけ繰り返し出力される。見出しと注記は 1 回だけ表示すればよいので、
     先頭以外の重複を CSS の一般兄弟結合子で隠す (JS 不使用)。 */
  .writing-lint-pending .wl-header ~ .wl-header,
  .writing-lint-pending .wl-note ~ .wl-note {
    display: none;
  }
  .wl-row {
    background: #fff;
    border: 1px solid var(--harness-line);
    border-radius: 4px;
    padding: 12px 16px;
    margin-bottom: 8px;
  }
  .wl-row:last-child { margin-bottom: 0; }
  .wl-pattern {
    font-size: 0.9em;
    margin-bottom: 4px;
  }
  .wl-cmd {
    display: block;
    font-family: ui-monospace, "SF Mono", monospace;
    font-size: 0.85em;
    background: #F5F4F1;
    padding: 6px 10px;
    border-radius: 4px;
    overflow-x: auto;
    white-space: pre;
  }
</style>
</head>
<body>
<main>
  <h1>{{project}}</h1>
  <div class="meta">Generated at {{generated_at}}</div>

  <div class="pct-block">
    <div class="pct-num">{{progress_pct}}%</div>
    <div class="pct-label">タスク完了率</div>
    <div class="progress-bar">
      <div class="progress-fill"></div>
    </div>
    <div class="counts">
      <span><strong>{{_done_count}}</strong>件 完了</span>
      <span><strong>{{_wip_count}}</strong>件 進行中</span>
      <span><strong>{{_todo_count}}</strong>件 未着手</span>
    </div>
  </div>

  <div class="current">
    <div class="current-label">現在のタスク</div>
    <div class="current-task">{{current_task}}</div>
  </div>

  <section>{{#alerts}}
    <div class="alert alert-{{severity}}">
      <span class="alert-kind">{{kind}}</span>
      {{message}}
      <div class="alert-action">→ {{suggested_action}}</div>
    </div>{{/alerts}}
  </section>

  <div class="stats">
    <div class="stat-card">
      <div class="stat-label">経過 / 推定 (分)</div>
      <div class="stat-value">{{elapsed_minutes}} / {{estimated_total_minutes}}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">コスト (USD)</div>
      <div class="stat-value">${{cost_so_far_usd}} / ${{cost_estimate_usd}}</div>
    </div>
  </div>

  <section>
    <h2>進行中のタスク</h2>
    <ul>{{#wip_tasks}}
      <li>
        <span class="task-num">{{number}}</span>
        <span class="task-title">{{title}}</span>
      </li>{{/wip_tasks}}
    </ul>
  </section>

  <section>
    <h2>直近完了したタスク</h2>
    <ul>{{#_done_recent_items}}
      <li>
        <span class="task-num">{{number}}</span>
        <span class="task-title">{{title}}</span>
        <span class="task-commit">{{commit}}</span>
      </li>{{/_done_recent_items}}
    </ul>
  </section>

  <section>
    <h2>未着手のタスク (top 5)</h2>
    <ul>{{#todo_tasks}}
      <li>
        <span class="task-num">{{number}}</span>
        <span class="task-title">{{title}}</span>
      </li>{{/todo_tasks}}
    </ul>
  </section>

  <section class="writing-lint-pending">{{#writing_lint_pending}}
    <h2 class="wl-header">承認待ちの表現ルール ({{pending_count}} 件)</h2>
    <div class="wl-note">ボタンではありません。下のコマンドをターミナルにそのままコピペして実行してください。</div>
    <div class="wl-row">
      <div class="wl-pattern">{{pattern}}</div>
      <code class="wl-cmd">{{approve_command}}</code>
    </div>{{/writing_lint_pending}}
  </section>

  <section class="audit-trail" style="margin-top:32px;padding:16px 20px;background:#F5F4F1;border:1px solid #E5E5E5;border-radius:4px;font-size:0.85em;color:#52524C;">
    <h2 style="margin:0 0 8px;font-size:0.9em;font-weight:500;text-transform:uppercase;letter-spacing:0.05em;color:#52524C;">🔍 この artifact の根拠</h2>
    <ul style="list-style:none;margin:0;padding:0;line-height:1.8;">
      <li><strong>検索範囲</strong>: {{audit_search_scope}}</li>
      <li><strong>参照 ID</strong>: {{audit_referenced_ids}}</li>
      <li><strong>redact 件数</strong>: {{audit_redaction_summary}}</li>
      <li><strong>audit log</strong>: {{audit_log_path}}</li>
    </ul>
  </section>

  <footer>
    Progress Tracker — Phase 65.4 Cognitive-Load Surface (3rd of 3) — schema: progress-snapshot.v1
  </footer>
</main>
</body>
</html>
